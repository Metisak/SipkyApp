{
  "appId": "cz.sipky.app",
  "appName": "Sipky s Kotzim",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0a0a0f",
      "showSpinner": false,
      "androidSpinnerStyle": "small",
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "backgroundColor": "#0a0a0f",
      "style": "LIGHT",
      "overlaysWebView": false
    }
  },
  "android": {
    "backgroundColor": "#0a0a0f",
    "allowMixedContent": true,
    "overScrollMode": "never"
  }
}
